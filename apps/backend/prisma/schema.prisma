// =============================================================================
// PRISMA SCHEMA — Acadchestra
// Learn more: https://pris.ly/d/prisma-schema
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum PlanType {
  LITE
  PROFESSIONAL
  ENTERPRISE
  MULTI_SCHOOL
}

enum TermStructure {
  TWO_SEMESTERS
  THREE_TERMS
  FOUR_QUARTERS
  CUSTOM
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  LOCKED
}

enum CalendarPhase {
  SETUP // Year created, terms defined, no teaching yet
  TEACHING // Normal term in progress, instruction active
  EXAMS // Exam window — academic structure locked
  BREAK // Holiday / mid-term break — teaching paused
  PROMOTION_WINDOW // Year-end promotion window — promotions allowed
  ARCHIVED // Year ended and archived
}

enum AcademicPeriodType {
  TERM
  HOLIDAY
  EXAM_WEEK
  MID_TERM_BREAK
}

enum AcademicProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  HOLIDAY
  COMPLETED
}

enum ClassType {
  REGULAR
  HONORS
  SPECIAL
  BILINGUAL
  VOCATIONAL
  PREP
}

enum SubjectCategory {
  CORE
  ELECTIVE
  LANGUAGE
  SCIENCE
  ARTS
  SPORTS
  VOCATIONAL
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  DROPPED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  RESIGNED
}

enum ExamType {
  TERM_EXAM
  MID_TERM
  UNIT_TEST
  ASSESSMENT
  FINAL_EXAM
  ENTRANCE
}

enum PromotionStatus {
  PENDING
  PROMOTED
  RETAINED
  GRADUATED
  TRANSFERRED
  SKIPPED
}

enum FeeType {
  ANNUAL
  TERM_WISE
  MONTHLY
  ONE_TIME
  CUSTOM
}

enum FeeCategory {
  ACADEMIC
  FACILITIES
  TRANSPORT
  HOSTEL
  MEALS
  ACTIVITIES
  TECHNOLOGY
  UNIFORM
  OTHER
}

enum FeeStructureScope {
  SCHOOL_WIDE
  CLASS_SPECIFIC
  GRADE_SPECIFIC
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOIDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountScope {
  TOTAL_FEE
  COMPONENT
}

enum DiscountStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
  REVERSAL
  ADJUSTMENT
  WAIVER
  DISCOUNT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  ONLINE
  CHEQUE
  MOBILE_MONEY
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  VOIDED
}

enum AllocationStrategy {
  FIFO
  PRIORITY
  MANUAL
}

enum CurrencyPosition {
  BEFORE
  AFTER
}

enum TimeFormat {
  H12
  H24
}

enum NotificationType {
  FEE_DUE
  FEE_OVERDUE
  PAYMENT_RECEIVED
  TERM_STARTING
  TERM_ACTIVATED
  TERM_OVERDUE
  ACADEMIC_YEAR_ENDING
  PROMOTION_READY
  ARREARS_ALERT
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  PAYMENT
  LOGIN
  LOGOUT
  STATUS_CHANGE
  ROLE_ASSIGNMENT
  PROMOTION
  BILLING
  WAIVER
  DISCOUNT
  FINANCIAL_LOCK
  ACADEMIC_LOCK
}

enum ActivityEntityType {
  TENANT
  TENANT_SETTINGS
  USER
  ACADEMIC_YEAR
  ACADEMIC_TERM
  ACADEMIC_PERIOD
  CLASS
  STUDENT
  STUDENT_CLASS_HISTORY
  TEACHER
  FEE_STRUCTURE
  FEE_STRUCTURE_VERSION
  STUDENT_FEE
  FEE_PAYMENT
  FEE_COMPONENT
  FEE_ALLOCATION
  EXAMINATION
  ROLE
  FEE_STRUCTURE_LEVEL
  FEE_LEDGER
  TERM_ACTIVATION_BILLING
  INVOICE
  STUDENT_DISCOUNT
  PROMOTION
  NOTIFICATION
  PROMOTION_PLAN
  PROMOTION_PLAN_ENTRY
  ATTENDANCE_SESSION
  ATTENDANCE_RECORD
}

enum PromotionPlanStatus {
  DRAFT // Generated, not reviewed
  REVIEWING // Admin is editing mappings
  APPROVED // Validated, ready to execute
  EXECUTING // In progress
  EXECUTED // Committed
  CANCELLED
}

enum PromotionStrategy {
  PRESERVE_STREAM // Keep same stream in target grade
  BALANCED_DISTRIBUTION // Spread students across streams
  CUSTOM_MAPPING // Fully manual — no strategy inference
  GRADE_ONLY // Target year has no streams — grade++ only
}

enum PromotionPlanEntryStatus {
  PENDING
  APPROVED
  CONFLICTED
  OVERRIDDEN
  SKIPPED
  GRADUATED
  RETAINED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  SICK
  HOLIDAY
}

enum AttendanceSessionStatus {
  DRAFT // Register opened but not yet finalized
  FINALIZED // Teacher submitted
  LOCKED // Admin-locked (no further edits)
}

enum AttendanceSessionType {
  DAILY // Whole-day class register (most common)
  SUBJECT // Subject-period based (optional)
  AM // Morning only
  PM // Afternoon only
}

// =============================================================================
// MULTI-TENANT
// =============================================================================

model Tenant {
  id        String  @id @default(cuid())
  name      String
  domain    String  @unique
  subdomain String? @unique
  email     String
  phone     String?
  address   String?
  logo      String?
  website   String?

  planType    PlanType @default(LITE)
  isActive    Boolean  @default(true)
  maxStudents Int      @default(100)

  termStructure    TermStructure @default(THREE_TERMS)
  gradeStructure   Json?
  feeConfiguration Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings              TenantSettings?
  users                 User[]
  roles                 Role[]
  academicYears         AcademicYear[]
  academicTerms         AcademicTerm[]
  academicPeriods       AcademicPeriod[]
  classes               Class[]
  subjects              Subject[]
  students              Student[]
  studentClassHistories StudentClassHistory[]
  teachers              Teacher[]
  feeStructures         FeeStructure[]
  feeStructureVersions  FeeStructureVersion[]
  studentFees           StudentFee[]
  feePayments           FeePayment[]
  examinations          Examination[]
  activityLogs          ActivityLog[]
  feeStructureLevels    FeeStructureLevel[]
  feeLedgerEntries      FeeLedger[]
  invoices              Invoice[]
  studentDiscounts      StudentDiscount[]
  promotions            StudentPromotion[]
  notifications         Notification[]
  reportSnapshots       ReportSnapshot[]
  promotionPlans        PromotionPlan[]
  attendanceSessions    AttendanceSession[]
  attendanceRecords     AttendanceRecord[]

  @@map("tenants")
}

// =============================================================================
// USERS & RBAC
// =============================================================================

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String? @unique
  password String

  firstName   String
  lastName    String
  phone       String?
  avatar      String?
  dateOfBirth DateTime?
  gender      Gender?

  isEmailVerified    Boolean   @default(false)
  isTwoFactorEnabled Boolean   @default(false)
  lastLogin          DateTime?
  isActive           Boolean   @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles     UserRole[]
  student       Student?
  teacher       Teacher?
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([tenantId, isActive])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  name        String
  description String?
  isSystem    Boolean @default(false)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([name, tenantId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// =============================================================================
// ACADEMIC STRUCTURE
// =============================================================================

model AcademicYear {
  id            String             @id @default(cuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean            @default(false)
  termStructure TermStructure      @default(THREE_TERMS)
  totalTerms    Int                @default(3)
  status        AcademicYearStatus @default(DRAFT)

  isLocked     Boolean   @default(false)
  lockedAt     DateTime?
  lockedReason String?

  isFinanciallyLocked Boolean   @default(false)
  financiallyLockedAt DateTime?
  financialLockReason String?

  streamsByGrade Json? @default("{}")

  promotionWindowStart DateTime?
  promotionWindowEnd   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes               Class[]
  terms                 AcademicTerm[]
  academicPeriods       AcademicPeriod[]
  attendanceSessions    AttendanceSession[]
  feeStructures         FeeStructure[]
  studentClassHistories StudentClassHistory[]
  promotions            StudentPromotion[]

  @@unique([name, tenantId])
  @@index([tenantId, isCurrent, status])
  @@index([tenantId, startDate, endDate])
  @@map("academic_years")
}

model AcademicTerm {
  id         String   @id @default(cuid())
  name       String
  shortName  String
  termNumber Int
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean  @default(false)
  hasExams   Boolean  @default(true)
  hasFees    Boolean  @default(true)
  examWeeks  Int      @default(2)

  billingGeneratedAt DateTime?
  billingLocked      Boolean   @default(false)

  isLocked     Boolean   @default(false)
  lockedAt     DateTime?
  lockedReason String?

  isFinanciallyLocked Boolean   @default(false)
  financiallyLockedAt DateTime?

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeStructures      FeeStructure[]
  attendanceSessions AttendanceSession[]
  examinations       Examination[]
  invoices           Invoice[]
  academicPeriods    AcademicPeriod[]

  @@unique([academicYearId, termNumber])
  @@unique([name, academicYearId])
  @@index([tenantId, academicYearId, startDate, endDate])
  @@index([tenantId, isActive])
  @@map("academic_terms")
}

model AcademicPeriod {
  id        String             @id @default(cuid())
  name      String
  type      AcademicPeriodType
  startDate DateTime
  endDate   DateTime
  notes     String?

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, academicYearId, startDate, endDate])
  @@index([tenantId, type])
  @@map("academic_periods")
}

model PromotionPlan {
  id       String              @id @default(cuid())
  name     String
  status   PromotionPlanStatus @default(DRAFT)
  strategy PromotionStrategy   @default(PRESERVE_STREAM)

  fromAcademicYearId String
  toAcademicYearId   String

  totalStudents      Int @default(0)
  plannedPromotions  Int @default(0)
  plannedGraduations Int @default(0)
  plannedRetentions  Int @default(0)
  conflictsCount     Int @default(0)
  warningsCount      Int @default(0)

  notes   String?
  summary Json? // warnings, stats, strategy snapshot

  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  executedById  String?
  executedAt    DateTime?
  cancelledById String?
  cancelledAt   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  entries PromotionPlanEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, toAcademicYearId])
  @@map("promotion_plans")
}

model PromotionPlanEntry {
  id String @id @default(cuid())

  planId String
  plan   PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  studentId        String
  fromClassId      String?
  suggestedClassId String?
  overrideClassId  String?
  finalClassId     String?

  fromStream      String?
  suggestedStream String?
  overrideStream  String?
  finalStream     String?

  status PromotionPlanEntryStatus @default(PENDING)
  action String // PROMOTE | RETAIN | GRADUATE | SKIP

  warnings   Json? // string[]
  conflicts  Json? // string[]
  adminNotes String?

  // Populated after execution
  executedPromotionId String?
  executedAt          DateTime?

  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, studentId])
  @@index([planId, status])
  @@index([tenantId, studentId])
  @@map("promotion_plan_entries")
}

model Class {
  id          String    @id @default(cuid())
  name        String
  displayName String?
  gradeLevel  Int
  section     String?
  capacity    Int       @default(40)
  classType   ClassType @default(REGULAR)
  stream      String?
  language    String?
  curriculum  String?

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  classTeacherId String?
  classTeacher   Teacher? @relation(fields: [classTeacherId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students              Student[]             @relation("StudentCurrentClass")
  studentClassHistories StudentClassHistory[]
  subjects              ClassSubject[]
  attendanceSessions    AttendanceSession[]
  feeStructures         FeeStructure[]
  feeStructureLevels    FeeStructureLevel[]
  promotionsFrom        StudentPromotion[]    @relation("PromotionFromClass")
  promotionsTo          StudentPromotion[]    @relation("PromotionToClass")

  @@unique([name, academicYearId, tenantId])
  @@index([tenantId, academicYearId, gradeLevel])
  @@map("classes")
}

model Subject {
  id           String          @id @default(cuid())
  name         String
  code         String
  description  String?
  gradeLevel   Int
  isCompulsory Boolean         @default(true)
  credits      Int             @default(1)
  category     SubjectCategory @default(CORE)
  department   String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes ClassSubject[]

  @@unique([code, tenantId])
  @@map("subjects")
}

model ClassSubject {
  id             String  @id @default(cuid())
  classId        String
  subjectId      String
  teacherId      String?
  periodsPerWeek Int?    @default(5)

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// =============================================================================
// PEOPLE
// =============================================================================

model Student {
  id               String        @id @default(cuid())
  rollNumber       String
  admissionNumber  String
  admissionDate    DateTime
  academicStatus   StudentStatus @default(ACTIVE)
  emergencyContact String?
  emergencyPhone   String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation("StudentCurrentClass", fields: [classId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classHistories    StudentClassHistory[]
  attendanceRecords AttendanceRecord[]
  studentFees       StudentFee[]
  ledgerEntries     FeeLedger[]
  invoices          Invoice[]
  discounts         StudentDiscount[]
  promotions        StudentPromotion[]

  @@unique([rollNumber, tenantId])
  @@unique([admissionNumber, tenantId])
  @@index([tenantId, classId, academicStatus])
  @@map("students")
}

model StudentClassHistory {
  id             String    @id @default(cuid())
  studentId      String
  classId        String
  academicYearId String
  stream         String?
  startDate      DateTime  @default(now())
  endDate        DateTime?
  isCurrent      Boolean   @default(true)
  reason         String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, studentId, isCurrent])
  @@index([tenantId, academicYearId, classId])
  @@map("student_class_histories")
}

model StudentPromotion {
  id             String          @id @default(cuid())
  studentId      String
  fromClassId    String?
  toClassId      String?
  academicYearId String
  status         PromotionStatus @default(PENDING)
  notes          String?
  promotedById   String?
  promotedAt     DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClass    Class?       @relation("PromotionFromClass", fields: [fromClassId], references: [id])
  toClass      Class?       @relation("PromotionToClass", fields: [toClassId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, academicYearId, status])
  @@map("student_promotions")
}

model Teacher {
  id               String           @id @default(cuid())
  employeeId       String
  joiningDate      DateTime
  designation      String
  department       String?
  qualification    String?
  experience       Int?
  salary           Float?
  employmentStatus EmploymentStatus @default(ACTIVE)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classesAsTeacher Class[]
  subjectsTaught   ClassSubject[]

  @@unique([employeeId, tenantId])
  @@map("teachers")
}

// =============================================================================
// FEE STRUCTURES (Versioned)
// =============================================================================

model FeeStructure {
  id          String            @id @default(cuid())
  name        String
  description String?
  feeType     FeeType           @default(TERM_WISE)
  scope       FeeStructureScope @default(SCHOOL_WIDE)

  isRecurring Boolean @default(true)
  isOptional  Boolean @default(false)
  isAutoBill  Boolean @default(true)

  isLocked     Boolean   @default(false)
  lockedAt     DateTime?
  lockedReason String?

  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id])

  classId    String?
  class      Class?  @relation(fields: [classId], references: [id])
  gradeLevel Int?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions      FeeStructureVersion[]
  feeComponents FeeComponent[]
  studentFees   StudentFee[]
  levels        FeeStructureLevel[]
  invoices      Invoice[]

  @@index([tenantId, academicYearId, academicTermId])
  @@index([tenantId, classId, gradeLevel])
  @@index([tenantId, scope, isAutoBill])
  @@map("fee_structures")
}

model FeeStructureVersion {
  id            String    @id @default(cuid())
  version       Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  snapshot      Json
  changeReason  String?

  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  createdById String?

  @@unique([feeStructureId, version])
  @@index([tenantId, feeStructureId, isActive])
  @@map("fee_structure_versions")
}

model FeeComponent {
  id           String      @id @default(cuid())
  name         String
  description  String?
  amount       Float
  currency     String      @default("KES")
  isCompulsory Boolean     @default(true)
  category     FeeCategory @default(ACADEMIC)
  dueDate      DateTime?
  lateFee      Float?      @default(0)
  sortOrder    Int         @default(0)
  priority     Int         @default(100)

  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentFeeComponents StudentFeeComponent[]

  @@index([feeStructureId, sortOrder])
  @@map("fee_components")
}

model FeeStructureLevel {
  id          String @id @default(cuid())
  levelLabel  String
  totalAmount Float  @default(0)

  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  classId    String?
  class      Class?  @relation(fields: [classId], references: [id])
  gradeLevel Int?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components FeeLevelComponent[]

  @@unique([feeStructureId, classId])
  @@index([feeStructureId, gradeLevel])
  @@index([tenantId])
  @@map("fee_structure_levels")
}

model FeeLevelComponent {
  id           String      @id @default(cuid())
  name         String
  description  String?
  amount       Float
  currency     String      @default("KES")
  isCompulsory Boolean     @default(true)
  category     FeeCategory @default(ACADEMIC)
  dueDate      DateTime?
  lateFee      Float?      @default(0)
  sortOrder    Int         @default(0)
  priority     Int         @default(100)

  feeStructureLevelId String
  level               FeeStructureLevel @relation(fields: [feeStructureLevelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([feeStructureLevelId, sortOrder])
  @@map("fee_level_components")
}

// =============================================================================
// DISCOUNTS / SCHOLARSHIPS
// =============================================================================

model StudentDiscount {
  id             String         @id @default(cuid())
  name           String
  description    String?
  discountType   DiscountType   @default(PERCENTAGE)
  scope          DiscountScope  @default(TOTAL_FEE)
  value          Float
  componentName  String?
  status         DiscountStatus @default(ACTIVE)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  academicYearId String?
  academicTermId String?
  approvedById   String?
  reason         String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, studentId, status])
  @@index([tenantId, academicYearId, academicTermId])
  @@map("student_discounts")
}

// =============================================================================
// INVOICE SYSTEM
// =============================================================================

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  status        InvoiceStatus @default(DRAFT)

  subtotal       Float @default(0)
  discountAmount Float @default(0)
  totalAmount    Float @default(0)
  paidAmount     Float @default(0)
  pendingAmount  Float @default(0)

  notes      String?
  footerText String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id])

  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])

  studentFeeId String?     @unique
  studentFee   StudentFee? @relation(fields: [studentFeeId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([invoiceNumber, tenantId])
  @@index([tenantId, studentId, status])
  @@index([tenantId, academicTermId])
  @@map("invoices")
}

// =============================================================================
// STUDENT FEES
// =============================================================================

model StudentFee {
  id             String    @id @default(cuid())
  totalAmount    Float
  discountAmount Float     @default(0)
  paidAmount     Float     @default(0)
  pendingAmount  Float
  dueDate        DateTime?
  status         FeeStatus @default(PENDING)

  previousBalance Float   @default(0)
  isArrears       Boolean @default(false)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])

  feeStructureVersionId String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components    StudentFeeComponent[]
  payments      FeePayment[]
  ledgerEntries FeeLedger[]
  invoice       Invoice?

  @@unique([studentId, feeStructureId])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, dueDate])
  @@map("student_fees")
}

model StudentFeeComponent {
  id                  String    @id @default(cuid())
  name                String
  amount              Float
  discountAmount      Float     @default(0)
  paidAmount          Float     @default(0)
  sortOrder           Int       @default(0)
  priority            Int       @default(100)
  status              FeeStatus @default(PENDING)
  dueDate             DateTime?
  feeLevelComponentId String?

  studentFeeId String
  studentFee   StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  feeComponentId String?
  feeComponent   FeeComponent? @relation(fields: [feeComponentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations FeePaymentAllocation[]

  @@unique([studentFeeId, feeComponentId])
  @@index([studentFeeId, sortOrder])
  @@index([studentFeeId, priority])
  @@map("student_fee_components")
}

// =============================================================================
// PAYMENTS & LEDGER
// =============================================================================

model FeePayment {
  id                 String             @id @default(cuid())
  receiptNumber      String
  amount             Float
  allocatedAmount    Float              @default(0)
  overpaymentAmount  Float              @default(0)
  paymentMethod      PaymentMethod      @default(CASH)
  allocationStrategy AllocationStrategy @default(FIFO)
  transactionId      String?
  referenceNumber    String?
  status             PaymentStatus      @default(COMPLETED)
  paidAt             DateTime           @default(now())
  voidedAt           DateTime?
  voidReason         String?
  notes              String?
  recordedById       String?

  studentFeeId String
  studentFee   StudentFee @relation(fields: [studentFeeId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations   FeePaymentAllocation[]
  ledgerEntries FeeLedger[]

  @@unique([receiptNumber, tenantId])
  @@index([tenantId, paidAt])
  @@index([tenantId, paymentMethod])
  @@index([tenantId, status])
  @@map("fee_payments")
}

model FeePaymentAllocation {
  id     String @id @default(cuid())
  amount Float

  feePaymentId String
  feePayment   FeePayment @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)

  studentFeeComponentId String
  studentFeeComponent   StudentFeeComponent @relation(fields: [studentFeeComponentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([feePaymentId])
  @@index([studentFeeComponentId])
  @@map("fee_payment_allocations")
}

model FeeLedger {
  id           String          @id @default(cuid())
  entryType    LedgerEntryType
  amount       Float
  balanceAfter Float
  description  String
  reference    String?
  metadata     Json?
  recordedById String?
  occurredAt   DateTime        @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  studentFeeId String?
  studentFee   StudentFee? @relation(fields: [studentFeeId], references: [id], onDelete: SetNull)

  feePaymentId String?
  feePayment   FeePayment? @relation(fields: [feePaymentId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId, studentId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([tenantId, entryType])
  @@map("fee_ledger")
}

// =============================================================================
// EXAMINATIONS
// =============================================================================

model Examination {
  id           String   @id @default(cuid())
  name         String
  type         ExamType @default(TERM_EXAM)
  startDate    DateTime
  endDate      DateTime
  duration     Int?
  maxMarks     Int      @default(100)
  passingMarks Int      @default(40)

  academicTermId String
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, academicTermId])
  @@map("examinations")
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model AttendanceSession {
  id          String                  @id @default(cuid())
  sessionDate DateTime                @db.Date
  type        AttendanceSessionType   @default(DAILY)
  status      AttendanceSessionStatus @default(DRAFT)
  notes       String?

  // Aggregates (maintained by service on mark / finalize)
  totalStudents Int @default(0)
  presentCount  Int @default(0)
  absentCount   Int @default(0)
  lateCount     Int @default(0)
  excusedCount  Int @default(0)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: SetNull)

  subjectId String?
  // No FK relation to Subject intentionally — subject attendance is optional
  // and can reference ClassSubject label instead.

  takenById String?
  takenAt   DateTime?

  finalizedById String?
  finalizedAt   DateTime?

  lockedById String?
  lockedAt   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  records AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, sessionDate, type, subjectId])
  @@index([tenantId, sessionDate])
  @@index([tenantId, classId, sessionDate])
  @@index([tenantId, academicYearId, sessionDate])
  @@index([tenantId, academicTermId, sessionDate])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  status     AttendanceStatus @default(PRESENT)
  remark     String?
  markedAt   DateTime         @default(now())
  markedById String?

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([tenantId, studentId, status])
  @@index([tenantId, studentId, createdAt])
  @@map("attendance_records")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id       String              @id @default(cuid())
  type     NotificationType
  channel  NotificationChannel @default(IN_APP)
  status   NotificationStatus  @default(PENDING)
  title    String
  message  String
  metadata Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  readAt      DateTime?
  sentAt      DateTime?
  scheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, status])
  @@index([tenantId, type, createdAt])
  @@index([scheduledAt, status])
  @@map("notifications")
}

// =============================================================================
// REPORT SNAPSHOTS
// =============================================================================

model ReportSnapshot {
  id        String    @id @default(cuid())
  key       String
  data      Json
  validFrom DateTime  @default(now())
  validTo   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, key, validFrom])
  @@map("report_snapshots")
}

// =============================================================================
// AUDIT & ACTIVITY LOGS
// =============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  tableName String
  recordId  String
  oldValues Json?
  newValues Json?
  userId    String
  tenantId  String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id         String             @id @default(cuid())
  action     ActivityAction
  entityType ActivityEntityType
  entityId   String
  message    String
  metadata   Json?

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
  @@map("activity_logs")
}

// =============================================================================
// TENANT SETTINGS
// =============================================================================

model TenantSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  currency         String           @default("KES")
  currencySymbol   String           @default("KSh")
  currencyPosition CurrencyPosition @default(BEFORE)
  currencyDecimals Int              @default(2)
  timezone         String           @default("Africa/Nairobi")
  locale           String           @default("en-KE")
  dateFormat       String           @default("DD/MM/YYYY")
  timeFormat       TimeFormat       @default(H24)
  firstDayOfWeek   Int              @default(1)

  logoUrl        String?
  faviconUrl     String?
  primaryColor   String  @default("#3b82f6")
  secondaryColor String  @default("#8b5cf6")
  brandTagline   String?

  defaultGradingScale String @default("PERCENTAGE")
  passingGrade        Float  @default(50)
  attendanceThreshold Float  @default(75)

  receiptPrefix             String             @default("RCP")
  invoicePrefix             String             @default("INV")
  enableLateFees            Boolean            @default(false)
  lateFeePercentage         Float              @default(0)
  lateFeeGraceDays          Int                @default(0)
  enabledPaymentMethods     Json               @default("[\"CASH\",\"MOBILE_MONEY\",\"BANK_TRANSFER\",\"CHEQUE\"]")
  allowPartialPayments      Boolean            @default(true)
  allowOverpayment          Boolean            @default(false)
  requirePaymentReference   Boolean            @default(false)
  defaultAllocationStrategy AllocationStrategy @default(FIFO)
  autoCarryForwardArrears   Boolean            @default(true)

  enableEmailNotifications   Boolean @default(true)
  enableSmsNotifications     Boolean @default(false)
  enablePushNotifications    Boolean @default(false)
  feeReminderDays            Json    @default("[7,3,1]")
  termActivationReminderDays Json    @default("[7,3,1]")

  sessionTimeoutMinutes    Int     @default(60)
  passwordMinLength        Int     @default(8)
  passwordRequireUppercase Boolean @default(true)
  passwordRequireNumber    Boolean @default(true)
  passwordRequireSymbol    Boolean @default(false)
  requireTwoFactor         Boolean @default(false)
  maxLoginAttempts         Int     @default(5)
  lockoutDurationMinutes   Int     @default(15)

  emailSenderName    String?
  emailSenderAddress String?
  smsProvider        String?
  smsSenderId        String?

  enableParentPortal   Boolean @default(true)
  enableStudentPortal  Boolean @default(true)
  enableOnlinePayments Boolean @default(false)
  enableBulkImport     Boolean @default(true)
  enableAutoPromotion  Boolean @default(false)

  customFields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_settings")
}
