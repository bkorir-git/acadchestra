// =============================================================================
// MULTI-TENANT
// =============================================================================

model Tenant {
  id        String  @id @default(cuid())
  name      String
  domain    String  @unique
  subdomain String? @unique
  email     String
  phone     String?
  address   String?
  logo      String?
  website   String?

  planType    PlanType @default(LITE)
  isActive    Boolean  @default(true)
  maxStudents Int      @default(100)

  // Default term structure for new academic years
  termStructure TermStructure @default(THREE_TERMS)

  // Onboarding tracking
  isOnboarded         Boolean   @default(false)
  onboardedAt         DateTime?
  onboardingStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Relations ────────────────────────────────────────────────────────────
  settings          TenantSettings?
  configs           Config[]
  policies          Policy[]
  admissionCounter  AdmissionCounter?

  users    User[]
  roles    Role[]
  teachers Teacher[]
  uploadAssets    UploadAsset[]

  curriculums           Curriculum[]
  grades                Grade[]
  academicYears         AcademicYear[]
  academicTerms         AcademicTerm[]
  academicPeriods       AcademicPeriod[]
  classes               Class[]
  streams               Stream[]
  subjects              Subject[]
  students              Student[]
  guardians             Guardian[]
  studentGuardians      StudentGuardian[]
  studentClassHistories StudentClassHistory[]

  feeStructures        FeeStructure[]
  feeStructureVersions FeeStructureVersion[]
  feeStructureLevels   FeeStructureLevel[]
  feePaymentRules      FeePaymentRule[]
  studentFees          StudentFee[]
  feePayments          FeePayment[]
  feeLedgerEntries     FeeLedger[]
  invoices             Invoice[]
  studentDiscounts     StudentDiscount[]

  examinations    Examination[]
  promotions      StudentPromotion[]
  promotionPlans  PromotionPlan[]

  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]

  notifications   Notification[]
  emailTemplates  EmailTemplate[]
  emailDeliveries EmailDelivery[]

  activityLogs    ActivityLog[]
  reportSnapshots ReportSnapshot[]

  @@index([isActive, planType])
  @@map("tenants")
}

// =============================================================================
// USERS & RBAC
// =============================================================================

// `User` is a LOGIN IDENTITY only. Profile data (firstName, etc) is duplicated
// onto Student / Teacher / Guardian when those entities exist without a User
// (lower-primary kids, parents who don't want a portal).
model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String? @unique
  password String

  firstName   String
  lastName    String
  phone       String?
  avatar      String?
  dateOfBirth DateTime?
  gender      Gender?

  isEmailVerified    Boolean   @default(false)
  isTwoFactorEnabled Boolean   @default(false)
  mustChangePassword Boolean   @default(false) // set true on temp password issuance
  lastLogin          DateTime?
  isActive           Boolean   @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles     UserRole[]
  student       Student?
  teacher       Teacher?
  guardian      Guardian?
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([tenantId, isActive])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  name        String
  description String?
  isSystem    Boolean @default(false)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([name, tenantId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// =============================================================================
// SETTINGS — I18N + Branding ONLY (typed, stable, queried-every-request)
// =============================================================================

model TenantSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ─── Localization ────────────────────────────────────────────────
  currency         String           @default("KES")
  currencySymbol   String           @default("KSh")
  currencyPosition CurrencyPosition @default(BEFORE)
  currencyDecimals Int              @default(2)
  timezone         String           @default("Africa/Nairobi")
  locale           String           @default("en-KE")
  dateFormat       String           @default("DD/MM/YYYY")
  timeFormat       TimeFormat       @default(H24)
  firstDayOfWeek   Int              @default(1)

  // ─── Branding ────────────────────────────────────────────────────
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String  @default("#3b82f6")
  secondaryColor String  @default("#8b5cf6")
  brandTagline   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_settings")
}

// =============================================================================
// CONFIG ENGINE — flexible per-category rules
// =============================================================================

model Config {
  id          String   @id @default(cuid())
  tenantId    String
  category    String // 'academic' | 'student' | 'guardian' | 'fee' | 'security' | 'comms' | 'features'
  key         String
  value       Json
  description String?
  isLocked    Boolean  @default(false) // if true, only SuperAdmin can change

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, category, key])
  @@index([tenantId, category])
  @@map("configs")
}

model Policy {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  category    String
  description String?
  rules       Json // expression tree (JSONLogic / custom DSL)
  isActive    Boolean  @default(true)
  priority    Int      @default(100)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, category, isActive])
  @@map("policies")
}

// =============================================================================
// CURRICULUM TEMPLATES (system-wide, SuperAdmin)
// =============================================================================

model CurriculumTemplate {
  id          String  @id @default(cuid())
  name        String  @unique // "CBC", "British", "IGCSE", "K-8-4-4", "University Semester"
  code        String  @unique // "cbc", "british", "igcse"
  country     String? // e.g. "KE", "GB"
  description String?
  isPublished Boolean @default(true)

  defaultTermStructure TermStructure?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades      GradeTemplate[]
  curriculums Curriculum[]

  @@map("curriculum_templates")
}

model GradeTemplate {
  id          String  @id @default(cuid())
  name        String // "PP1", "Grade 1", "Form 3"
  displayName String? // "Pre-Primary 1"
  levelOrder  Int

  curriculumTemplateId String
  curriculumTemplate   CurriculumTemplate @relation(fields: [curriculumTemplateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([curriculumTemplateId, levelOrder])
  @@unique([curriculumTemplateId, name])
  @@map("grade_templates")
}

// =============================================================================
// CURRICULUM (per-tenant, optionally forked from a template)
// =============================================================================

model Curriculum {
  id          String  @id @default(cuid())
  name        String // "Greenwood CBC"
  code        String? // optional shortcode
  description String?
  isActive    Boolean @default(true)
  isDefault   Boolean @default(false)

  // Provenance — null means built from scratch
  templateId String?
  template   CurriculumTemplate? @relation(fields: [templateId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades        Grade[]
  feeStructures FeeStructure[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("curriculums")
}

model Grade {
  id          String  @id @default(cuid())
  name        String // "PP1", "Grade 1", "Form 3"
  displayName String? // "Pre-Primary 1"
  levelOrder  Int // promotion ordering only

  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes       Class[]
  feeStructures FeeStructure[]
  subjects      Subject[]

  @@unique([tenantId, curriculumId, levelOrder])
  @@unique([tenantId, curriculumId, name])
  @@index([tenantId, curriculumId])
  @@map("grades")
}

// =============================================================================
// ACADEMIC STRUCTURE
// =============================================================================

model AcademicYear {
  id            String             @id @default(cuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean            @default(false)
  termStructure TermStructure      @default(THREE_TERMS)
  totalTerms    Int                @default(3)
  status        AcademicYearStatus @default(DRAFT)

  isLocked     Boolean   @default(false)
  lockedAt     DateTime?
  lockedReason String?

  isFinanciallyLocked Boolean   @default(false)
  financiallyLockedAt DateTime?
  financialLockReason String?

  promotionWindowStart DateTime?
  promotionWindowEnd   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes               Class[]
  terms                 AcademicTerm[]
  academicPeriods       AcademicPeriod[]
  attendanceSessions    AttendanceSession[]
  feeStructures         FeeStructure[]
  studentClassHistories StudentClassHistory[]
  promotions            StudentPromotion[]

  @@unique([name, tenantId])
  @@index([tenantId, isCurrent, status])
  @@index([tenantId, startDate, endDate])
  @@map("academic_years")
}

model AcademicTerm {
  id         String   @id @default(cuid())
  name       String
  shortName  String
  termNumber Int
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean  @default(false)
  hasExams   Boolean  @default(true)
  hasFees    Boolean  @default(true)
  examWeeks  Int      @default(2)

  billingGeneratedAt DateTime?
  billingLocked      Boolean   @default(false)

  isLocked     Boolean   @default(false)
  lockedAt     DateTime?
  lockedReason String?

  isFinanciallyLocked Boolean   @default(false)
  financiallyLockedAt DateTime?

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeStructures      FeeStructure[]
  feePaymentRules    FeePaymentRule[]
  attendanceSessions AttendanceSession[]
  examinations       Examination[]
  invoices           Invoice[]
  academicPeriods    AcademicPeriod[]

  @@unique([academicYearId, termNumber])
  @@unique([name, academicYearId])
  @@index([tenantId, academicYearId, startDate, endDate])
  @@index([tenantId, isActive])
  @@map("academic_terms")
}

model AcademicPeriod {
  id        String             @id @default(cuid())
  name      String
  type      AcademicPeriodType
  startDate DateTime
  endDate   DateTime
  notes     String?

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, academicYearId, startDate, endDate])
  @@index([tenantId, type])
  @@map("academic_periods")
}

// =============================================================================
// CLASSES & STREAMS
// =============================================================================

model Class {
  id          String    @id @default(cuid())
  name        String // "Grade 1 East", "Form 3 Blue"
  displayName String?
  section     String?
  capacity    Int       @default(40)
  classType   ClassType @default(REGULAR)
  language    String?

  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  classTeacherId String?
  classTeacher   Teacher? @relation(fields: [classTeacherId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  streams Stream[]

  students              Student[]             @relation("StudentCurrentClass")
  studentClassHistories StudentClassHistory[]
  subjects              ClassSubject[]
  attendanceSessions    AttendanceSession[]
  feeStructures         FeeStructure[]
  feeStructureLevels    FeeStructureLevel[]
  promotionsFrom        StudentPromotion[]    @relation("PromotionFromClass")
  promotionsTo          StudentPromotion[]    @relation("PromotionToClass")

  @@unique([name, academicYearId, tenantId])
  @@index([tenantId, academicYearId, gradeId])
  @@map("classes")
}

model Stream {
  id       String  @id @default(cuid())
  name     String // "A", "Red", "Science"
  capacity Int?
  color    String? // for UI

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students      Student[]      @relation("StudentCurrentStream")
  feeStructures FeeStructure[]

  @@unique([classId, name])
  @@index([tenantId, classId])
  @@map("streams")
}

// =============================================================================
// SUBJECTS
// =============================================================================

model Subject {
  id           String          @id @default(cuid())
  name         String
  code         String
  description  String?
  isCompulsory Boolean         @default(true)
  credits      Int             @default(1)
  category     SubjectCategory @default(CORE)
  department   String?

  gradeId String?
  grade   Grade?  @relation(fields: [gradeId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes ClassSubject[]

  @@unique([code, tenantId])
  @@index([tenantId, gradeId])
  @@map("subjects")
}

model ClassSubject {
  id             String  @id @default(cuid())
  classId        String
  subjectId      String
  teacherId      String?
  periodsPerWeek Int?    @default(5)

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// =============================================================================
// ADMISSION COUNTER
// =============================================================================

model AdmissionCounter {
  id              String            @id @default(cuid())
  tenantId        String            @unique
  prefix          String            @default("") // "GW" or ""
  yearPrefix      String? // "2026" if YEAR_PREFIXED
  currentSequence Int               @default(0)
  paddingLength   Int               @default(4)
  strategy        AdmissionStrategy @default(SEQUENTIAL)
  lastIssuedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admission_counters")
}

// =============================================================================
// PEOPLE — STUDENTS, GUARDIANS, TEACHERS
// =============================================================================

// `Student` carries its OWN profile data because most students (lower primary)
// will never have a User account. When a portal account is needed, `userId` is
// set lazily.
model Student {
  id              String    @id @default(cuid())
  admissionNumber String    // immutable lifetime ID — issued by AdmissionCounter
  rollNumber      String?   // optional, per-class register number, config-driven
  admissionDate   DateTime  @default(now())

  firstName   String
  middleName  String?
  lastName    String
  dateOfBirth DateTime?
  gender      Gender?
  nationality String?
  bloodGroup  String?
  photoUrl    String?

  // Optional contact — never required at DB level (config-driven)
  email String?
  phone String?

  // Optional User link — only when student has a portal login
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ─── Class / Stream pointers (denormalised, kept in sync by ClassHistory)
  classId String
  class   Class  @relation("StudentCurrentClass", fields: [classId], references: [id], onDelete: Restrict)

  streamId String?
  stream   Stream? @relation("StudentCurrentStream", fields: [streamId], references: [id], onDelete: SetNull)

  academicStatus StudentStatus @default(ACTIVE)

  notes String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Relations ──────────────────────────────────────────────
  guardians         StudentGuardian[]
  classHistories    StudentClassHistory[]
  attendanceRecords AttendanceRecord[]
  studentFees       StudentFee[]
  ledgerEntries     FeeLedger[]
  invoices          Invoice[]
  discounts         StudentDiscount[]
  promotions        StudentPromotion[]

  @@unique([rollNumber, tenantId])
  @@unique([admissionNumber, tenantId])
  @@index([tenantId, classId, academicStatus])
  @@index([tenantId, streamId])
  @@map("students")
}

model Guardian {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String
  middleName  String?
  email       String?
  phone       String
  altPhone    String?
  occupation  String?
  employer    String?
  address     String?
  nationalId  String?
  photoUrl    String?

  // Optional User link for parent portal access
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students StudentGuardian[]

  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@map("guardians")
}

model StudentGuardian {
  id                 String               @id @default(cuid())
  studentId          String
  guardianId         String
  relationship       GuardianRelationship
  isPrimary          Boolean              @default(false)
  isEmergencyContact Boolean              @default(false)
  canPickup          Boolean              @default(true)
  receivesFinancials Boolean              @default(true)
  receivesAcademics  Boolean              @default(true)
  notes              String?

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, guardianId])
  @@index([tenantId, studentId])
  @@index([tenantId, guardianId])
  @@map("student_guardians")
}

model StudentClassHistory {
  id             String    @id @default(cuid())
  studentId      String
  classId        String
  academicYearId String
  streamId       String?
  startDate      DateTime  @default(now())
  endDate        DateTime?
  isCurrent      Boolean   @default(true)
  reason         String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, studentId, isCurrent])
  @@index([tenantId, academicYearId, classId])
  @@map("student_class_histories")
}

model StudentPromotion {
  id             String          @id @default(cuid())
  studentId      String
  fromClassId    String?
  toClassId      String?
  academicYearId String
  status         PromotionStatus @default(PENDING)
  notes          String?
  promotedById   String?
  promotedAt     DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClass    Class?       @relation("PromotionFromClass", fields: [fromClassId], references: [id])
  toClass      Class?       @relation("PromotionToClass", fields: [toClassId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, academicYearId, status])
  @@map("student_promotions")
}

model PromotionPlan {
  id       String              @id @default(cuid())
  name     String
  status   PromotionPlanStatus @default(DRAFT)
  strategy PromotionStrategy   @default(PRESERVE_STREAM)

  fromAcademicYearId String
  toAcademicYearId   String

  totalStudents      Int @default(0)
  plannedPromotions  Int @default(0)
  plannedGraduations Int @default(0)
  plannedRetentions  Int @default(0)
  conflictsCount     Int @default(0)
  warningsCount      Int @default(0)

  notes   String?
  summary Json?

  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  executedById  String?
  executedAt    DateTime?
  cancelledById String?
  cancelledAt   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  entries PromotionPlanEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, toAcademicYearId])
  @@map("promotion_plans")
}

model PromotionPlanEntry {
  id String @id @default(cuid())

  planId String
  plan   PromotionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  studentId        String
  fromClassId      String?
  suggestedClassId String?
  overrideClassId  String?
  finalClassId     String?

  fromStreamId      String?
  suggestedStreamId String?
  overrideStreamId  String?
  finalStreamId     String?

  status PromotionPlanEntryStatus @default(PENDING)
  action String

  warnings   Json?
  conflicts  Json?
  adminNotes String?

  executedPromotionId String?
  executedAt          DateTime?

  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, studentId])
  @@index([planId, status])
  @@index([tenantId, studentId])
  @@map("promotion_plan_entries")
}

model Teacher {
  id               String           @id @default(cuid())
  employeeId       String
  joiningDate      DateTime
  designation      String
  department       String?
  qualification    String?
  experience       Int?
  salary           Float?
  employmentStatus EmploymentStatus @default(ACTIVE)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classesAsTeacher Class[]
  subjectsTaught   ClassSubject[]

  @@unique([employeeId, tenantId])
  @@map("teachers")
}

// =============================================================================
// FEE STRUCTURES
// =============================================================================

model FeeStructure {
  id          String            @id @default(cuid())
  name        String
  description String?
  feeType     FeeType           @default(TERM_WISE)
  scope       FeeStructureScope @default(SCHOOL_WIDE)

  isRecurring Boolean @default(true)
  isOptional  Boolean @default(false)
  isAutoBill  Boolean @default(true)

  isLocked     Boolean   @default(false)
  lockedAt     DateTime?
  lockedReason String?

  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id])

  // ─── NORMALIZED scope targets ──
  curriculumId String?
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id])

  gradeId String?
  grade   Grade?  @relation(fields: [gradeId], references: [id])

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  streamId String?
  stream   Stream? @relation(fields: [streamId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions      FeeStructureVersion[]
  feeComponents FeeComponent[]
  studentFees   StudentFee[]
  levels        FeeStructureLevel[]
  invoices      Invoice[]

  @@index([tenantId, academicYearId, academicTermId])
  @@index([tenantId, curriculumId, gradeId])
  @@index([tenantId, classId, streamId])
  @@index([tenantId, scope, isAutoBill])
  @@map("fee_structures")
}

model FeeStructureVersion {
  id            String    @id @default(cuid())
  version       Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  snapshot      Json
  changeReason  String?

  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  createdById String?

  @@unique([feeStructureId, version])
  @@index([tenantId, feeStructureId, isActive])
  @@map("fee_structure_versions")
}

model FeeComponent {
  id           String      @id @default(cuid())
  name         String
  description  String?
  amount       Float
  currency     String      @default("KES")
  isCompulsory Boolean     @default(true)
  category     FeeCategory @default(ACADEMIC)
  dueDate      DateTime?
  lateFee      Float?      @default(0)
  sortOrder    Int         @default(0)
  priority     Int         @default(100)

  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentFeeComponents StudentFeeComponent[]

  @@index([feeStructureId, sortOrder])
  @@map("fee_components")
}

model FeeStructureLevel {
  id          String @id @default(cuid())
  levelLabel  String
  totalAmount Float  @default(0)

  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  gradeId String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components FeeLevelComponent[]

  @@unique([feeStructureId, classId])
  @@index([feeStructureId, gradeId])
  @@index([tenantId])
  @@map("fee_structure_levels")
}

model FeeLevelComponent {
  id           String      @id @default(cuid())
  name         String
  description  String?
  amount       Float
  currency     String      @default("KES")
  isCompulsory Boolean     @default(true)
  category     FeeCategory @default(ACADEMIC)
  dueDate      DateTime?
  lateFee      Float?      @default(0)
  sortOrder    Int         @default(0)
  priority     Int         @default(100)

  feeStructureLevelId String
  level               FeeStructureLevel @relation(fields: [feeStructureLevelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([feeStructureLevelId, sortOrder])
  @@map("fee_level_components")
}

// =============================================================================
// FEE PAYMENT RULES — drives "by week N, X% must be paid"
// =============================================================================

model FeePaymentRule {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Optional term scoping — null means applies to all terms
  termId String?
  term   AcademicTerm? @relation(fields: [termId], references: [id], onDelete: Cascade)

  byWeek        Int // e.g. 2 = "by end of week 2 of the term"
  minPercentage Float // e.g. 50 = "at least 50% paid"
  lateFeePerDay Float?

  isActive Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, termId, isActive])
  @@map("fee_payment_rules")
}

// =============================================================================
// DISCOUNTS / SCHOLARSHIPS
// =============================================================================

model StudentDiscount {
  id             String         @id @default(cuid())
  name           String
  description    String?
  discountType   DiscountType   @default(PERCENTAGE)
  scope          DiscountScope  @default(TOTAL_FEE)
  value          Float
  componentName  String?
  status         DiscountStatus @default(ACTIVE)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  academicYearId String?
  academicTermId String?
  approvedById   String?
  reason         String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, studentId, status])
  @@index([tenantId, academicYearId, academicTermId])
  @@map("student_discounts")
}

// =============================================================================
// INVOICES
// =============================================================================

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  status        InvoiceStatus @default(DRAFT)

  subtotal       Float @default(0)
  discountAmount Float @default(0)
  totalAmount    Float @default(0)
  paidAmount     Float @default(0)
  pendingAmount  Float @default(0)

  notes      String?
  footerText String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id])

  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])

  studentFeeId String?     @unique
  studentFee   StudentFee? @relation(fields: [studentFeeId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([invoiceNumber, tenantId])
  @@index([tenantId, studentId, status])
  @@index([tenantId, academicTermId])
  @@map("invoices")
}

// =============================================================================
// STUDENT FEES
// =============================================================================

model StudentFee {
  id             String    @id @default(cuid())
  totalAmount    Float
  discountAmount Float     @default(0)
  paidAmount     Float     @default(0)
  pendingAmount  Float
  dueDate        DateTime?
  status         FeeStatus @default(PENDING)

  previousBalance Float   @default(0)
  isArrears       Boolean @default(false)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])

  feeStructureVersionId String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components    StudentFeeComponent[]
  payments      FeePayment[]
  ledgerEntries FeeLedger[]
  invoice       Invoice?

  @@unique([studentId, feeStructureId])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, dueDate])
  @@map("student_fees")
}

model StudentFeeComponent {
  id                  String    @id @default(cuid())
  name                String
  amount              Float
  discountAmount      Float     @default(0)
  paidAmount          Float     @default(0)
  sortOrder           Int       @default(0)
  priority            Int       @default(100)
  status              FeeStatus @default(PENDING)
  dueDate             DateTime?
  feeLevelComponentId String?

  studentFeeId String
  studentFee   StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  feeComponentId String?
  feeComponent   FeeComponent? @relation(fields: [feeComponentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations FeePaymentAllocation[]

  @@unique([studentFeeId, feeComponentId])
  @@index([studentFeeId, sortOrder])
  @@index([studentFeeId, priority])
  @@map("student_fee_components")
}

// =============================================================================
// PAYMENTS & LEDGER
// =============================================================================

model FeePayment {
  id                 String             @id @default(cuid())
  receiptNumber      String
  amount             Float
  allocatedAmount    Float              @default(0)
  overpaymentAmount  Float              @default(0)
  paymentMethod      PaymentMethod      @default(CASH)
  allocationStrategy AllocationStrategy @default(FIFO)
  transactionId      String?
  referenceNumber    String?
  status             PaymentStatus      @default(COMPLETED)
  paidAt             DateTime           @default(now())
  voidedAt           DateTime?
  voidReason         String?
  notes              String?
  recordedById       String?

  studentFeeId String
  studentFee   StudentFee @relation(fields: [studentFeeId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations   FeePaymentAllocation[]
  ledgerEntries FeeLedger[]

  @@unique([receiptNumber, tenantId])
  @@index([tenantId, paidAt])
  @@index([tenantId, paymentMethod])
  @@index([tenantId, status])
  @@map("fee_payments")
}

model FeePaymentAllocation {
  id     String @id @default(cuid())
  amount Float

  feePaymentId String
  feePayment   FeePayment @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)

  studentFeeComponentId String
  studentFeeComponent   StudentFeeComponent @relation(fields: [studentFeeComponentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([feePaymentId])
  @@index([studentFeeComponentId])
  @@map("fee_payment_allocations")
}

model FeeLedger {
  id           String          @id @default(cuid())
  entryType    LedgerEntryType
  amount       Float
  balanceAfter Float
  description  String
  reference    String?
  metadata     Json?
  recordedById String?
  occurredAt   DateTime        @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  studentFeeId String?
  studentFee   StudentFee? @relation(fields: [studentFeeId], references: [id], onDelete: SetNull)

  feePaymentId String?
  feePayment   FeePayment? @relation(fields: [feePaymentId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId, studentId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([tenantId, entryType])
  @@map("fee_ledger")
}

// =============================================================================
// EXAMINATIONS
// =============================================================================

model Examination {
  id           String   @id @default(cuid())
  name         String
  type         ExamType @default(TERM_EXAM)
  startDate    DateTime
  endDate      DateTime
  duration     Int?
  maxMarks     Int      @default(100)
  passingMarks Int      @default(40)

  academicTermId String
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, academicTermId])
  @@map("examinations")
}

// =============================================================================
// ATTENDANCE
// =============================================================================

model AttendanceSession {
  id          String                  @id @default(cuid())
  sessionDate DateTime                @db.Date
  type        AttendanceSessionType   @default(DAILY)
  status      AttendanceSessionStatus @default(DRAFT)
  notes       String?

  totalStudents Int @default(0)
  presentCount  Int @default(0)
  absentCount   Int @default(0)
  lateCount     Int @default(0)
  excusedCount  Int @default(0)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: SetNull)

  subjectId String?

  takenById     String?
  takenAt       DateTime?
  finalizedById String?
  finalizedAt   DateTime?
  lockedById    String?
  lockedAt      DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  records AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, sessionDate, type, subjectId])
  @@index([tenantId, sessionDate])
  @@index([tenantId, classId, sessionDate])
  @@index([tenantId, academicYearId, sessionDate])
  @@index([tenantId, academicTermId, sessionDate])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  status     AttendanceStatus @default(PRESENT)
  remark     String?
  markedAt   DateTime         @default(now())
  markedById String?

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([tenantId, studentId, status])
  @@index([tenantId, studentId, createdAt])
  @@map("attendance_records")
}

// =============================================================================
// EMAIL (templates + delivery audit)
// =============================================================================

model EmailTemplate {
  id          String  @id @default(cuid())
  code        String  // 'welcome' | 'password_reset' | 'fee_reminder' | ...
  name        String
  description String?
  subject     String
  body        String  // mustache / handlebars-style placeholders
  isHtml      Boolean @default(true)
  isActive    Boolean @default(true)
  isSystem    Boolean @default(false) // SuperAdmin-managed defaults

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries EmailDelivery[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("email_templates")
}

model EmailDelivery {
  id              String      @id @default(cuid())
  toEmail         String
  toName          String?
  subject         String
  bodySnapshot    String
  status          EmailStatus @default(QUEUED)
  providerMessageId String?
  errorMessage    String?
  sentAt          DateTime?
  deliveredAt     DateTime?
  context         Json?       // template variables snapshot

  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([toEmail])
  @@map("email_deliveries")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id       String              @id @default(cuid())
  type     NotificationType
  channel  NotificationChannel @default(IN_APP)
  status   NotificationStatus  @default(PENDING)
  title    String
  message  String
  metadata Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  readAt      DateTime?
  sentAt      DateTime?
  scheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, status])
  @@index([tenantId, type, createdAt])
  @@index([scheduledAt, status])
  @@map("notifications")
}

model UploadAsset {
  id            String         @id @default(cuid())
  category      UploadCategory
  fileName      String         // original filename from user
  storedName    String         // randomized name on disk/object storage
  mimeType      String
  sizeBytes     Int
  checksum      String?        // sha256 hex
  storagePath   String         // opaque key, e.g. "tenants/abc/student_photo/xyz.png"
  storageDriver String         @default("local") // "local" | "r2" | "s3"
  status        UploadStatus   @default(ACTIVE)
  ownerId       String?
  ownerType     String?        // "USER" | "TENANT" | "SYSTEM"
  metadata      Json?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, category, status])
  @@index([category, status])
  @@index([storageDriver, status])
  @@map("upload_assets")
}

model BackupPolicy {
  id            String   @id @default(cuid())
  isEnabled     Boolean  @default(true)
  scheduleCron  String   @default("0 2 * * *") // daily at 02:00
  retentionKeep Int      @default(5)            // keep N most recent successful backups
  includeUploads Boolean @default(true)
  remoteSync    Boolean  @default(true)         // push to R2 when configured
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("backup_policies")
}

model BackupJob {
  id              String        @id @default(cuid())
  type            BackupType    @default(MANUAL)
  status          BackupStatus  @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  totalSizeBytes  Int?
  archivePath     String?       // local path to .tar.gz
  remoteKey       String?       // R2 object key
  remoteUrl       String?       // signed/public URL (if generated)
  errorMessage    String?
  triggeredById   String?       // user id who triggered (manual)
  manifest        Json?         // table counts, file counts, version
  retainedUntil   DateTime?     // null = governed by retention policy

  artifacts BackupArtifact[]
  restores  RestoreJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@map("backup_jobs")
}

model BackupArtifact {
  id        String             @id @default(cuid())
  kind      BackupArtifactKind
  path      String             // local path
  remoteKey String?            // R2 key if synced
  sizeBytes Int
  checksum  String?

  backupJobId String
  backupJob   BackupJob @relation(fields: [backupJobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([backupJobId])
  @@map("backup_artifacts")
}

model RestoreJob {
  id              String        @id @default(cuid())
  status          RestoreStatus @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  triggeredById   String        // user id who triggered (must be SuperAdmin)
  confirmationHash String       // bcrypt of password used to confirm
  notes           String?

  backupJobId String
  backupJob   BackupJob @relation(fields: [backupJobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("restore_jobs")
}


// =============================================================================
// REPORTS
// =============================================================================

model ReportSnapshot {
  id        String    @id @default(cuid())
  key       String
  data      Json
  validFrom DateTime  @default(now())
  validTo   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, key, validFrom])
  @@map("report_snapshots")
}

// =============================================================================
// AUDIT & ACTIVITY
// =============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  tableName String
  recordId  String
  oldValues Json?
  newValues Json?
  userId    String
  tenantId  String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id         String             @id @default(cuid())
  action     ActivityAction
  entityType ActivityEntityType
  entityId   String
  message    String
  metadata   Json?

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
  @@map("activity_logs")
}
