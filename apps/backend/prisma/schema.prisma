// =============================================================================
// PRISMA SCHEMA — Acadchestra v2
//
// @description Fully normalized, curriculum-agnostic, policy-driven schema.
//   Replaces the legacy schema. See docs/FLAWS.md for the before-and-after audit
//   and docs/README.md for the design principles.
//
// Key changes vs v1:
//   - NEW:  CurriculumTemplate, GradeTemplate, Curriculum, Grade, Stream
//   - NEW:  Guardian, StudentGuardian (M:N with relationship metadata)
//   - NEW:  AdmissionCounter (race-safe sequential numbering)
//   - NEW:  Config, Policy (dynamic per-tenant rules)
//   - NEW:  FeePaymentRule (term payment % schedule)
//   - NEW:  EmailTemplate, EmailDelivery (auditable email)
//   - REF:  Class.gradeId  (was: gradeLevel:Int)
//   - REF:  Class.streams[]  (was: stream:String)
//   - REF:  FeeStructure.gradeId/classId/streamId  (was: gradeLevel:Int)
//   - REF:  Student.userId  is now OPTIONAL
//   - DEL:  Tenant.gradeStructure, Tenant.feeConfiguration
//   - DEL:  AcademicYear.streamsByGrade
//   - DEL:  50+ columns from TenantSettings → moved to Config
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

