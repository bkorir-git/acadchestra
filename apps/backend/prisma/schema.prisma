// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-tenant model - Schools/Organizations
model Tenant {
  id          String   @id @default(cuid())
  name        String
  domain      String   @unique
  subdomain   String?  @unique
  email       String
  phone       String?
  address     String?
  logo        String?
  website     String?
  settings      TenantSettings?
  
  // Subscription details
  planType    PlanType @default(LITE)
  isActive    Boolean  @default(true)
  maxStudents Int      @default(100)
  
  // Academic configuration
  termStructure    TermStructure @default(THREE_TERMS)
  gradeStructure   Json? // Store grade/level structure configuration
  feeConfiguration Json? // Store fee calculation rules
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  users       User[]
  roles       Role[]
  academicYears AcademicYear[]
  academicTerms AcademicTerm[]
  classes       Class[]
  subjects      Subject[]
  students      Student[]
  teachers      Teacher[]
  feeStructures FeeStructure[]
  studentFees   StudentFee[]
  feePayments   FeePayment[]
  examinations  Examination[]
  activityLogs  ActivityLog[]

  @@map("tenants")
}

enum PlanType {
  LITE
  PROFESSIONAL
  ENTERPRISE
  MULTI_SCHOOL
}

enum TermStructure {
  TWO_SEMESTERS   // Semester 1, Semester 2
  THREE_TERMS     // Term 1, Term 2, Term 3
  FOUR_QUARTERS   // Quarter 1, Quarter 2, Quarter 3, Quarter 4
  CUSTOM          // Configurable terms
}

// User management with RBAC
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String?  @unique
  password    String
  
  // Personal info
  firstName   String
  lastName    String
  phone       String?
  avatar      String?
  dateOfBirth DateTime?
  gender      Gender?
  
  // Security
  isEmailVerified Boolean @default(false)
  isTwoFactorEnabled Boolean @default(false)
  lastLogin         DateTime?
  isActive          Boolean  @default(true)
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userRoles         UserRole[]
  student           Student?
  teacher           Teacher?
  activityLogs      ActivityLog[]

  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// Role-based access control
model Role {
  id              String   @id @default(cuid())
  name            String
  description     String?
  isSystem        Boolean  @default(false)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([name, tenantId])
  @@map("roles")
}

model Permission {
  id              String   @id @default(cuid())
  resource        String
  action          String
  description     String?
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  
  // Relations
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// Academic Structure
model AcademicYear {
  id            String             @id @default(cuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean            @default(false)
  termStructure TermStructure      @default(THREE_TERMS)
  totalTerms    Int                @default(3)
  status        AcademicYearStatus @default(DRAFT)
  isLocked      Boolean            @default(false)
  lockedAt      DateTime?
  lockedReason  String?
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  classes       Class[]
  terms         AcademicTerm[]
  feeStructures FeeStructure[]

  @@unique([name, tenantId])
  @@index([tenantId, isCurrent, status])
  @@map("academic_years")
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  LOCKED
}

model AcademicTerm {
  id             String         @id @default(cuid())
  name           String
  shortName      String
  termNumber     Int
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean        @default(false)
  hasExams       Boolean        @default(true)
  hasFees        Boolean        @default(true)
  examWeeks      Int            @default(2)
  isLocked       Boolean        @default(false)
  lockedAt       DateTime?
  lockedReason   String?
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  feeStructures  FeeStructure[]
  examinations   Examination[]

  @@unique([academicYearId, termNumber])
  @@unique([name, academicYearId])
  @@index([tenantId, academicYearId, startDate, endDate])
  @@map("academic_terms")
}

model Class {
  id             String    @id @default(cuid())
  name           String
  displayName    String?
  gradeLevel     Int
  section        String?
  capacity       Int       @default(40)
  classType      ClassType @default(REGULAR)
  stream         String?
  language       String?
  curriculum     String?
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  classTeacherId String?
  classTeacher   Teacher?  @relation(fields: [classTeacherId], references: [id])
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  students       Student[]
  subjects       ClassSubject[]
  feeStructures  FeeStructure[]

  @@unique([name, academicYearId, tenantId])
  @@map("classes")
}

enum ClassType {
  REGULAR     // Regular class
  HONORS      // Honors/Advanced class
  SPECIAL     // Special needs class
  BILINGUAL   // Bilingual class
  VOCATIONAL  // Vocational/Technical class
  PREP        // Preparatory class
}

model Subject {
  id           String          @id @default(cuid())
  name         String
  code         String
  description  String?
  gradeLevel   Int
  isCompulsory Boolean         @default(true)
  credits      Int             @default(1)
  category     SubjectCategory @default(CORE)
  department   String?
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  classes      ClassSubject[]

  @@unique([code, tenantId])
  @@map("subjects")
}

enum SubjectCategory {
  CORE
  ELECTIVE
  LANGUAGE
  SCIENCE
  ARTS
  SPORTS
  VOCATIONAL
}

model ClassSubject {
  id             String   @id @default(cuid())
  classId        String
  subjectId      String
  teacherId      String?
  periodsPerWeek Int?     @default(5)
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// Student management
model Student {
  id              String        @id @default(cuid())
  rollNumber      String
  admissionNumber String
  admissionDate   DateTime
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId         String
  class           Class         @relation(fields: [classId], references: [id])
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicStatus  StudentStatus @default(ACTIVE)
  emergencyContact String?
  emergencyPhone  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  studentFees     StudentFee[]

  @@unique([rollNumber, tenantId])
  @@unique([admissionNumber, tenantId])
  @@map("students")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  DROPPED
}

// Teacher/Staff management
model Teacher {
  id               String           @id @default(cuid())
  employeeId       String
  joiningDate      DateTime
  designation      String
  department       String?
  qualification    String?
  experience       Int?
  salary           Float?
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employmentStatus EmploymentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  classesAsTeacher Class[]
  subjectsTaught   ClassSubject[]

  @@unique([employeeId, tenantId])
  @@map("teachers")
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  RESIGNED
}

// Fee Structure System - Configurable
model FeeStructure {
  id             String        @id @default(cuid())
  name           String
  description    String?
  feeType        FeeType       @default(TERM_WISE)
  isRecurring    Boolean       @default(true)
  isOptional     Boolean       @default(false)

  isLocked       Boolean       @default(false)
  lockedAt       DateTime?
  lockedReason   String?

  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id])
  classId        String?
  class          Class?        @relation(fields: [classId], references: [id])
  gradeLevel     Int?
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  feeComponents  FeeComponent[]
  studentFees    StudentFee[]

  @@index([tenantId, academicYearId, academicTermId])
  @@index([tenantId, classId, gradeLevel])
  @@map("fee_structures")
}

enum FeeType {
  ANNUAL
  TERM_WISE
  MONTHLY
  ONE_TIME
  CUSTOM
}

model FeeComponent {
  id                   String               @id @default(cuid())
  name                 String
  description          String?
  amount               Float
  currency             String               @default("KES")
  isCompulsory         Boolean              @default(true)
  category             FeeCategory          @default(ACADEMIC)
  dueDate              DateTime?
  lateFee              Float?               @default(0)
  sortOrder            Int                  @default(0)  // FIFO ordering
  feeStructureId       String
  feeStructure         FeeStructure         @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  studentFeeComponents StudentFeeComponent[]

  @@map("fee_components")
}

enum FeeCategory {
  ACADEMIC
  FACILITIES
  TRANSPORT
  HOSTEL
  MEALS
  ACTIVITIES
  TECHNOLOGY
  UNIFORM
  OTHER
}

// Student fee tracking
model StudentFee {
  id             String               @id @default(cuid())
  studentId      String
  student        Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId String
  feeStructure   FeeStructure         @relation(fields: [feeStructureId], references: [id])
  totalAmount    Float
  paidAmount     Float                @default(0)
  pendingAmount  Float
  dueDate        DateTime?
  status         FeeStatus            @default(PENDING)
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  components     StudentFeeComponent[]
  payments       FeePayment[]

  @@unique([studentId, feeStructureId])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@map("student_fees")
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

model StudentFeeComponent {
  id             String       @id @default(cuid())
  studentFeeId   String
  studentFee     StudentFee   @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  feeComponentId String
  feeComponent   FeeComponent @relation(fields: [feeComponentId], references: [id])
  name           String       // snapshot name
  amount         Float
  paidAmount     Float        @default(0)
  sortOrder      Int          @default(0)
  status         FeeStatus    @default(PENDING)
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  allocations    FeePaymentAllocation[]

  @@unique([studentFeeId, feeComponentId])
  @@index([studentFeeId, sortOrder])
  @@map("student_fee_components")
}

model FeePayment {
  id              String        @id @default(cuid())
  receiptNumber   String        // unique per tenant
  studentFeeId    String
  studentFee      StudentFee    @relation(fields: [studentFeeId], references: [id])
  amount          Float
  allocatedAmount Float         @default(0)
  paymentMethod   PaymentMethod @default(CASH)
  transactionId   String?       // external ref (M-Pesa code etc)
  referenceNumber String?       // bank slip / cheque no
  status          PaymentStatus @default(COMPLETED)
  paidAt          DateTime      @default(now())
  voidedAt        DateTime?
  voidReason      String?
  notes           String?
  recordedById    String?
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  allocations     FeePaymentAllocation[]

  @@unique([receiptNumber, tenantId])
  @@index([tenantId, paidAt])
  @@index([tenantId, paymentMethod])
  @@map("fee_payments")
}

model FeePaymentAllocation {
  id                   String              @id @default(cuid())
  feePaymentId         String
  feePayment           FeePayment          @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)
  studentFeeComponentId String
  studentFeeComponent   StudentFeeComponent @relation(fields: [studentFeeComponentId], references: [id], onDelete: Cascade)
  amount               Float
  createdAt            DateTime            @default(now())

  @@index([feePaymentId])
  @@index([studentFeeComponentId])
  @@map("fee_payment_allocations")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  ONLINE
  CHEQUE
  MOBILE_MONEY
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Examination system
model Examination {
  id            String   @id @default(cuid())
  name          String
  type          ExamType @default(TERM_EXAM)
  startDate     DateTime
  endDate       DateTime
  duration      Int?
  maxMarks      Int      @default(100)
  passingMarks  Int      @default(40)
  academicTermId String
  academicTerm  AcademicTerm @relation(fields: [academicTermId], references: [id])
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("examinations")
}

enum ExamType {
  TERM_EXAM
  MID_TERM
  UNIT_TEST
  ASSESSMENT
  FINAL_EXAM
  ENTRANCE
}

// Audit logging
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  tableName String
  recordId  String
  oldValues Json?
  newValues Json?
  userId    String
  tenantId  String
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model ActivityLog {
  id         String             @id @default(cuid())
  action     ActivityAction
  entityType ActivityEntityType
  entityId   String
  message    String
  metadata   Json?
  userId     String?
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId   String?
  tenant     Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt  DateTime           @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
  @@map("activity_logs")
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  PAYMENT
  LOGIN
  LOGOUT
  STATUS_CHANGE
  ROLE_ASSIGNMENT
}

enum ActivityEntityType {
  TENANT
  TENANT_SETTINGS
  USER
  ACADEMIC_YEAR
  ACADEMIC_TERM
  CLASS
  STUDENT
  TEACHER
  FEE_STRUCTURE
  STUDENT_FEE
  FEE_PAYMENT
  FEE_COMPONENT
  FEE_ALLOCATION
  EXAMINATION
  ROLE
  
}


enum CurrencyPosition {
  BEFORE
  AFTER
}

enum TimeFormat {
  H12
  H24
}

model TenantSettings {
  id                       String           @id @default(cuid())
  tenantId                 String           @unique
  tenant                   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ─── Localization ───
  currency                 String           @default("KES")     // ISO 4217 code
  currencySymbol           String           @default("KSh")
  currencyPosition         CurrencyPosition @default(BEFORE)
  currencyDecimals         Int              @default(2)
  timezone                 String           @default("Africa/Nairobi")
  locale                   String           @default("en-KE")
  dateFormat               String           @default("DD/MM/YYYY")
  timeFormat               TimeFormat       @default(H24)
  firstDayOfWeek           Int              @default(1)          // 0=Sun, 1=Mon

  // ─── Branding ───
  logoUrl                  String?
  faviconUrl               String?
  primaryColor             String           @default("#3b82f6")
  secondaryColor           String           @default("#8b5cf6")
  brandTagline             String?

  // ─── Academic ───
  defaultGradingScale      String           @default("PERCENTAGE")
  passingGrade             Float            @default(50)
  attendanceThreshold      Float            @default(75)

  // ─── Fee Settings ───
  receiptPrefix            String           @default("RCP")
  invoicePrefix            String           @default("INV")
  enableLateFees           Boolean          @default(false)
  lateFeePercentage        Float            @default(0)
  lateFeeGraceDays         Int              @default(0)
  enabledPaymentMethods    Json             @default("[\"CASH\",\"MOBILE_MONEY\",\"BANK_TRANSFER\",\"CHEQUE\"]")
  allowPartialPayments     Boolean          @default(true)
  allowOverpayment         Boolean          @default(false)
  requirePaymentReference  Boolean          @default(false)

  // ─── Notifications ───
  enableEmailNotifications Boolean          @default(true)
  enableSmsNotifications   Boolean          @default(false)
  enablePushNotifications  Boolean          @default(false)
  feeReminderDays          Json             @default("[7,3,1]")   // array of ints

  // ─── Security ───
  sessionTimeoutMinutes    Int              @default(60)
  passwordMinLength        Int              @default(8)
  passwordRequireUppercase Boolean          @default(true)
  passwordRequireNumber    Boolean          @default(true)
  passwordRequireSymbol    Boolean          @default(false)
  requireTwoFactor         Boolean          @default(false)
  maxLoginAttempts         Int              @default(5)
  lockoutDurationMinutes   Int              @default(15)

  // ─── Communications ───
  emailSenderName          String?
  emailSenderAddress       String?
  smsProvider              String?          // AFRICAS_TALKING | TWILIO | etc
  smsSenderId              String?

  // ─── Feature Flags ───
  enableParentPortal       Boolean          @default(true)
  enableStudentPortal      Boolean          @default(true)
  enableOnlinePayments     Boolean          @default(false)
  enableBulkImport         Boolean          @default(true)

  // ─── Custom ───
  customFields             Json?

  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@map("tenant_settings")
}